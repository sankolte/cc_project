# ===============================================
# Environment Configuration
# Cloud-Based Anomaly Detection Platform
# ===============================================

# Server Ports
MONITOR_PORT=5000
TARGET_PORT=3000

# Monitoring Service Ingestion URL
MONITOR_INGESTION_URL=http://localhost:5000/api/telemetry

# Database Configuration (Amazon RDS / Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anomaly_detection
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# AWS Cloud Settings (For Phase 4 Deployment)
AWS_REGION=ap-south-1
AWS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/telemetry-queue
AWS_S3_BUCKET=anomaly-telemetry-raw-logs

# Local Dev Mode Toggle
# When true, uses in-memory/local mock queue & storage for effortless offline development
USE_MOCK_AWS=true
